# Pocket Explorer — environment (§5 of the build brief)

# Primary data source: PoktScan/Pocketdex GraphQL indexer (POST, no auth).
# Public: the live status badge polls this from the client.
NEXT_PUBLIC_GRAPHQL_URL=https://data.pocket.network/graphql

# Fallback data source: Sauron node. Server-side only.
SAURON_LCD_URL=https://sauron-api.infra.pocket.network
SAURON_RPC_URL=https://sauron-rpc.infra.pocket.network

# Indexer-vs-RPC fallback threshold (blocks). Public so the live badge can
# evaluate lag client-side as well as server components.
NEXT_PUBLIC_INDEXER_LAG_THRESHOLD=5
